PORT=4000
LOG_LEVEL=error
NODE_ENV=development
HTTPS_PROXY=https://cdp_https_proxy/
HTTP_PROXY=http://cdp_https_proxy/
ENVIRONMENT=dev
DAL_REQUEST_TIMEOUT_MS=3000
GRAPHQL_DASHBOARD_ENABLED=true
DISABLE_AUTH=true

# Generate and validate api bearer token
OIDC_JWKS_URI=http://mock-jwks-endpoint
OIDC_JWKS_TIMEOUT_MS=3000

# Authorized entity IDs (appid/azp or group)
ADMIN_ENTITY_ID=some-entity-id
CONSOLIDATED_VIEW_ENTITY_ID=consolidated-view-entity-id
SINGLE_FRONT_DOOR_ENTITY_ID=single-front-door-entity-id
SFI_REFORM_ENTITY_ID=sfi-reform-entity-id
LAND_GRANTS_API_ENTITY_ID=land-grants-api-entity-id
LAND_APP_TECH_SPIKES_ENTITY_ID=land-app-tech-spikes-entity-id

# Defra ID Token verification
DEFRA_ID_WELL_KNOWN_URL=http://mock-defra-id-well-known-endpoint
DEFRA_ID_TIMEOUT_MS=3000

CLIENT_ID=some-client-id
CLIENT_SECRET=some-client-secret #pragma: allowlist secret

KITS_DISABLE_MTLS=true
KITS_GATEWAY_TIMEOUT_MS=3000
# Kits Gateway for RP (Locally generated self-signed cert and key for testing)
KITS_INTERNAL_GATEWAY_URL=https://rp_kits_gateway_internal_url/
# Kits Gateway for RP (Locally generated self-signed cert and key for testing)
KITS_EXTERNAL_GATEWAY_URL=https://rp_kits_gateway_external_url/
KIT_EXT_PERSON_ID_OVERRIDE=3337243
KITS_DAL_SERVICE_ACCOUNT_EMAIL=service-account@example.com

MONGO_DATABASE='fcp-dal-api'

# Disable Hitachi authentication for testing
HITACHI_DISABLE_AUTH=true
HITACHI_BASE_URL=https://hitachi_api_url/


# Currently set to the existing level of coverage. Should increase these thresholds as we increase coverage.
SCHEMA_FIELD_COVERAGE_THRESHOLD=100
SCHEMA_TYPE_COVERAGE_THRESHOLD=100
